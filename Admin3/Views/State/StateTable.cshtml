@using System.Data;
@using Admin3;
@using Admin3.Bal


<div class="d-flex justify-content-end align-items-center">
    <a class="btn btn-outline-primary" asp-controller="State" asp-action="StateAddEdit">
        <i class="bi bi-plus-lg"></i>&nbsp;Add City
    </a>
</div>

@if (TempData["StateInsertMsg"] != null)
{
    <div class="alert alert-success">
        @TempData["StateInsertMsg"]
    </div>
}


<div class="mb-3">
    <input type="text" class="form-control" id="StateSearch" placeholder="Search Any">
</div>

<table class="table table-hover table-header-fixed">
    <thead>
        <tr>
            <th scope="col">State Name</th>
            <th scope="col">State Code</th>
            <th scope="col">Country Name</th>
            <th scope="col">CityCount</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody id="StateTable">
        @foreach (DataRow row in Model.Rows)
        {
            <tr>
                <td>@row["StateName"]</td>
                <td>@row["StateCode"]</td>
                <td>@row["CountryName"]</td>
                <td>@row["CityCount"]</td>
                <td class="text-center">
                    <a class="btn btn-outline-success btn-xs" asp-controller="State" asp-action="StateAddEdit" asp-route-StateID="@UrlEncryptor.Encrypt(row["StateID"].ToString())">
                        <i class="bi bi-pencil-fill"></i>
                    </a>
                    <a class="btn btn-outline-danger btn-xs" asp-controller="State" asp-action="Delete" asp-route-StateID="@UrlEncryptor.Encrypt(row["StateID"].ToString())" onclick="return confirm('Are you sure you want to delete this State?');">
                        <i class="bi bi-x"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#StateSearch").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#StateTable tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}